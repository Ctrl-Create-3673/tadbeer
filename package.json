{
  "name": "hijri-life-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "TZ=UTC vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:win": "npm run build && electron-builder --win --publish never",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase": "^13.3.0",
    "harfbuzzjs": "^1.6.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "description": "Tadbeer: Hijri calendar, tasks, events and notes",
  "author": "Tadbeer",
  "build": {
    "appId": "com.tadbeer.desktop",
    "productName": "Tadbeer",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
