{
  "name": "Tadbeer – Hijri Planner",
  "short_name": "Tadbeer",
  "description": "Plan with Purpose. Organise with Clarity. Hijri calendar, tasks, events and notes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d17",
  "theme_color": "#0b0d17",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "./#/calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./#/tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reminders", "url": "./#/reminders", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
