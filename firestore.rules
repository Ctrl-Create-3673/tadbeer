rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each signed-in user can read and write only their own data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // invites: sender creates, the addressed friend answers (status only), either side can delete
    match /invites/{id} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'fromEmail', 'toEmail', 'store', 'json', 'at', 'status'])
        && request.resource.data.status == 'pending' && request.resource.data.store in ['events', 'tasks']
        && request.resource.data.toEmail is string && request.resource.data.toEmail.size() <= 200
        && request.resource.data.json is string && request.resource.data.json.size() <= 20000;
      allow read, delete: if request.auth != null && request.auth.token.email_verified
        && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == request.auth.token.email);
      allow update: if request.auth != null && request.auth.token.email_verified && resource.data.toEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
    }

    // anyone may send feedback (write only; only the owner reads it in the Firebase console)
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['mood', 'kind', 'used', 'message', 'email', 'at', 'app'])
        && request.resource.data.mood is int && request.resource.data.mood >= 1 && request.resource.data.mood <= 5
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.used is list && request.resource.data.used.size() <= 10;
    }
  }
}
