rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each signed-in user can read and write only their own data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // anyone may send feedback (write only; only the owner reads it in the Firebase console)
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['mood', 'kind', 'used', 'message', 'email', 'at', 'app'])
        && request.resource.data.mood is int && request.resource.data.mood >= 1 && request.resource.data.mood <= 5
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.used is list && request.resource.data.used.size() <= 10;
    }
  }
}
